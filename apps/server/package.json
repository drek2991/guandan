{
  "name": "@guandan/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative Guandan game server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsx --test test/**/*.test.ts test/**/*.test.mjs"
  },
  "dependencies": {
    "@guandan/protocol": "0.1.0",
    "express": "^5.2.1",
    "pg": "8.22.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  }
}
