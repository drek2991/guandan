# Authoritative server: optional, non-secret local override.
# Defaults to 3000 when unset.
PORT=3000

# Authoritative server: optional runtime mode.
# Allowed values: development, test, production.
NODE_ENV=development

# Authoritative server: required Supabase Postgres Session pooler URL.
# Set the real value only in the ignored .env; the server enforces TLS.
DATABASE_URL=

# Authoritative server: required CA certificate for verified TLS.
# Download from Supabase SSL Configuration and keep it under ignored .certs/.
DATABASE_CA_PATH=.certs/prod-ca-2021.crt

# Mobile: optional future public API location; currently unused.
# EXPO_PUBLIC_API_BASE_URL=http://192.0.2.1:3000
# EXPO_PUBLIC_ values are bundled into the app and are never secrets.
